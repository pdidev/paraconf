#ifndef PARACONF_VERSION_H__
#define PARACONF_VERSION_H__

#include <stdint.h>

// clang-format off
/// paraconf major revision number
#define PARACONF_VERSION_MAJOR @paraconf_VERSION_MAJOR@
/// paraconf minor revision number
#define PARACONF_VERSION_MINOR @paraconf_VERSION_MINOR@
/// paraconf patch revision number
#define PARACONF_VERSION_PATCH @paraconf_VERSION_PATCH@
/// paraconf pre-release suffix, such as `-beta2' or `-alpha.2026-10-07.1c4a1ed', empty for a release
#define PARACONF_VERSION_MODIF "@paraconf_VERSION_MODIF@"
/** paraconf version variant, such as pre-release
 * - number of days since Jan. 01 2015 for a git revision
 * - 65512 (2^16-24) + alpha number for an alpha release
 * - 65520 (2^16-16) + beta number for a beta release
 * - 65528 (2^16-8) + rc-number for a release candidate
 * - 65535 (0xFFFF or 2^16-1) for a normal release
 */
#define PARACONF_VERSION_VARIANT @paraconf_VERSION_VARIANT@
// clang-format on

/** Computes a version of paraconf as a 64 bit integer, comparable with PARACONF_VERSION and PC_version()
 *
 * The 16 upper bits are the major revision number, the 16 following ones the minor revision number, the 16 following ones the patch revision
 * number, and the 16 lower bits the variant, as PARACONF_VERSION_VARIANT describes it.
 */
#define PARACONF_COMPUTE_VERSION_WITH_VARIANT(MAJOR, MINOR, PATCH, VARIANT)                                                                          \
	((((uint64_t)(MAJOR)) << 48) | (((uint64_t)(MINOR)) << 32) | (((uint64_t)(PATCH)) << 16) | ((uint64_t)(VARIANT)))

/// The version of a release of paraconf as a 64 bit integer: its pre-releases compare lower
#define PARACONF_COMPUTE_VERSION(MAJOR, MINOR, PATCH) PARACONF_COMPUTE_VERSION_WITH_VARIANT(MAJOR, MINOR, PATCH, 65535)

/// PARACONF_COMPUTE_VERSION_WITH_VARIANT for the preprocessor, where the cast to uint64_t is not available: usable in #if only
#define PARACONF_UNTYPED_COMPUTE_VERSION_WITH_VARIANT(MAJOR, MINOR, PATCH, VARIANT) (((MAJOR) << 48) | ((MINOR) << 32) | ((PATCH) << 16) | (VARIANT))

/// PARACONF_COMPUTE_VERSION for the preprocessor: usable in #if only
#define PARACONF_UNTYPED_COMPUTE_VERSION(MAJOR, MINOR, PATCH) PARACONF_UNTYPED_COMPUTE_VERSION_WITH_VARIANT(MAJOR, MINOR, PATCH, 65535)

/// PARACONF_VERSION for the preprocessor: usable in #if only
#define PARACONF_UNTYPED_VERSION                                                                                                                     \
	PARACONF_UNTYPED_COMPUTE_VERSION_WITH_VARIANT(PARACONF_VERSION_MAJOR, PARACONF_VERSION_MINOR, PARACONF_VERSION_PATCH, PARACONF_VERSION_VARIANT)

/// The version of paraconf as a 64 bit integer, as PARACONF_COMPUTE_VERSION_WITH_VARIANT computes it
#define PARACONF_VERSION                                                                                                                             \
	PARACONF_COMPUTE_VERSION_WITH_VARIANT(PARACONF_VERSION_MAJOR, PARACONF_VERSION_MINOR, PARACONF_VERSION_PATCH, PARACONF_VERSION_VARIANT)

#endif // PARACONF_VERSION_H__
